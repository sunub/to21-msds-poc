# deploy/htodb/.env 의 견본(.env는 git 제외).
HTODB_PG_PASSWORD=
HTODB_READER_PASSWORD=
# SQL Server sa 비밀번호: 대문자·소문자·숫자·기호를 섞어 8자 이상
HTODB_MSSQL_SA_PASSWORD=
# setup.sh가 .env를 자동으로 만들므로 보통은 손으로 채울 필요 없음.
# HTODB.zip을 풀 폴더(저장소 밖 절대 경로, 자동 생성 기본값 ~/.cache/to21-htodb/mdf). 연결된 사본은 파일 버전이 올라가므로 원본 zip은 따로 둔다.
HTODB_MDF_DIR=
HTODB_PG_PORT=5433
HTODB_MSSQL_PORT=14330
