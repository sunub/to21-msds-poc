    "p_statements": [
     {
      "seq": 1,
      "code": "P201",
      "type": "예방",
      "text": "사용 전 취급 설명서를 확보하시오."
     },
     {
      "seq": 2,
      "code": "P202",
      "type": "예방",
      "text": "안전 예방조치 문구를 읽고 이해하기 전에는 취급하지 마시오."
     },
     {
      "seq": 3,
      "code": "P210",
      "type": "대응",
      "text": "열, 고온의 표면, 스파크, 화염 및 그 밖의 점화원으로부터 멀리하시오. 금연"
     },
     {
      "seq": 4,
      "code": "P233",
      "type": "대응",
      "text": "용기를 단단히 밀폐하시오."
     },
     {
      "seq": 5,
      "code": "P240",
      "type": "대응",
      "text": "용기와 수용설비를 접지하시오."
     },
     {
      "seq": 6,
      "code": "P241",
      "type": "대응",
      "text": "방폭형 (전기·환기·조명)설비를 사용하시오."
     },
     {
      "seq": 7,
      "code": "P242",
      "type": "대응",
      "text": "스파크가 발생하지 않는 도구를 사용하시오."
     },
     {
      "seq": 8,
      "code": "P243",
      "type": "대응",
      "text": "정전기 방지 조치를 취하시오."
     },
     {
      "seq": 9,
      "code": "P260",
      "type": "대응",
      "text": "가스/미스트/증기/스프레이를(을) 흡입하지 마시오."
     },
     {
      "seq": 10,
      "code": "P264",
      "type": "대응",
      "text": "취급 후에는 취급부위를 철저히 씻으시오."
     },
     {
      "seq": 11,
      "code": "P270",
      "type": "대응",
      "text": "이 제품을 사용할 때에는 먹거나, 마시거나 흡연하지 마시오."
     },
     {
      "seq": 12,
      "code": "P273",
      "type": "대응",
      "text": "환경으로 배출하지 마시오."
     },
     {
      "seq": 13,
      "code": "P280",
      "type": "대응",
      "text": "보호장갑·보호의·보안경·안면보호구를(을) 착용하시오."
     },
     {
      "seq": 14,
      "code": "P301+P310",
      "type": "대응",
      "text": "삼켰다면: 즉시 의료기관/의사의 진찰을 받으시오."
     },
     {
      "seq": 15,
      "code": "P302+P352",
      "type": "대응",
      "text": "피부에 묻으면: 다량의 물로 씻으시오."
     },
     {
      "seq": 16,
      "code": "P303+P361+P353",
      "type": "대응",
      "text": "피부(또는 머리카락)에 묻으면: 오염된 모든 의류를 즉시 벗으시오. 피부를 물로 씻으시오/샤워하시오."
     },
     {
      "seq": 17,
      "code": "P305+P351+P338",
      "type": "대응",
      "text": "눈에 묻으면: 몇 분간 물로 조심해서 씻으시오. 가능하면 콘택트렌즈를 제거하시오. 계속 씻으시오."
     },
     {
      "seq": 18,
      "code": "P308+P313",
      "type": "대응",
      "text": "노출되거나 노출이 우려되면: 의학적인 조치/조언을 받으시오."
     },
     {
      "seq": 19,
      "code": "P314",
      "type": "대응",
      "text": "불편함을 느끼면 의학적인 조치/조언을 받으시오."
     },
     {
      "seq": 20,
      "code": "P321",
      "type": "대응",
      "text": "응급처치(눈에 들어갔을 때는 다량의 흐르는 물로 세척, 피부에 접촉했을 때는 다량의 흐르는 물로 세척, 흡입했을 때 신선한 공기로 이동, 먹었을 때 구토를 유발할지에 대하여 의료진의 조언을 구함)를 하시오."
     },
     {
      "seq": 21,
      "code": "P331",
      "type": "대응",
      "text": "토하게 하지 마시오."
     },
     {
      "seq": 22,
      "code": "P332+P313",
      "type": "대응",
      "text": "피부 자극이 나타나면: 의학적인 조치/조언을 받으시오."
     },
     {
      "seq": 23,
      "code": "P337+P313",
      "type": "대응",
      "text": "눈에 자극이 지속되면: 의학적인 조치/조언을 받으시오."
     },
     {
      "seq": 24,
      "code": "P362+P364",
      "type": "대응",
      "text": "오염된 의류를 벗고 다시 사용 전 세척하시오."
     },
     {
      "seq": 25,
      "code": "P370+P378",
      "type": "대응",
      "text": "화재 시: 불을 끄기 위해 적절한 소화제를 사용하시오."
     },
     {
      "seq": 26,
      "code": "P391",
      "type": "대응",
      "text": "누출물을 모으시오."
     },
     {
      "seq": 27,
      "code": "P403+P235",
      "type": "저장",
      "text": "환기가 잘 되는 곳에 보관하시오. 저온으로 유지하시오."
     },
     {
      "seq": 28,
      "code": "P405",
      "type": "저장",
      "text": "잠금장치를 하여 저장하시오."
     },
     {
      "seq": 29,
      "code": "P501",
      "type": "폐기",
      "text": "폐기물 관련 법령에 따라 내용물/용기를 폐기하시오."
     }
    ],
