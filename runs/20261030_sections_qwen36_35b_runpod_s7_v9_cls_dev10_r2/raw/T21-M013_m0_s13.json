  "extras": [
   {
    "after_item": "S13_METHOD",
    "title_raw": "폐기시주의사항",
    "reason": "코드없음",
    "statements": [
     {
      "value": "수거하여재생하거나밀봉용기에담아서허가된폐기물처리장에서폐기할것이물질이하수구수로로유입되지않게할",
      "line": "p8:L39"
     },
     {
      "value": "것화학물질이나사용한용기로연못수로또는도랑을오염시키지말것폐기물관련법령에따라내용물용기를",
      "line": "p8:L40"
     },
     {
      "value": "폐기하시오.",
      "line": "p8:L41"
     }
    ],
    "suggested_code": "NARRATIVE_TEXT",
    "line": "p8:L39"
   },
   {
    "after_item": "S13_CAUTION",
    "title_raw": "지정폐기물의분류번호",
    "reason": "코드없음",
    "statements": [
     {
      "value": "사용자생산자폐기물처리업체가협의하여폐기물코드를부여해야함",
      "line": "p8:L44"
     }
    ],
    "suggested_code": "NARRATIVE_TEXT",
    "line": "p8:L44"
   },
   {
    "after_item": "S13_CAUTION",
    "title_raw": "오염된용기및",
    "reason": "코드없음",
    "statements": [
     {
      "value": "(빈용기에제품잔여물이있을수있으므로용기를비운후에도제품표지의경고사항을따를것빈용기는재활용또는",
      "line": "p8:L42"
     },
     {
      "value": "포장의폐기방법을포함함)폐기를위해허가된폐기물처리장에수집되어야함",
      "line": "p8:L43"
     }
    ],
    "suggested_code": "NARRATIVE_TEXT",
    "line": "p8:L42"
   }
  ]
 },
