      "narratives": [
        {
          "item_code": "S8_ENG",
          "title_raw": "1) 공학적 관리방법",
          "status": "값있음",
          "statements": [
            {
              "seq": 1,
              "key": null,
              "value": "작업 중 생성될 수 있는 먼지 및 가스를 빼낼 수 있는 배기장치를 필요로 한다.",
              "refs": null,
              "cond": null,
              "std_code": null,
              "match_score": null,
              "text": "작업 중 생성될 수 있는 먼지 및 가스를 빼낼 수 있는 배기장치를 필요로 한다."
            },
            {
              "seq": 2,
              "key": null,
              "value": "필요 시 먼지 및 유기용제용으로 공인된 마스크를 사용한다.",
              "refs": null,
              "cond": null,
              "std_code": null,
              "match_score": null,
              "text": "필요 시 먼지 및 유기용제용으로 공인된 마스크를 사용한다."
            }
          ]
        },
        {
          "item_code": "S8_RESP",
          "title_raw": "- 호흡기 보호",
          "status": "값있음",
          "statements": [
            {
              "seq": 1,
              "key": null,
              "value": "작업자는 분진 방지용 마스크를 사용할 것.",
              "refs": null,
              "cond": null,
              "std_code": null,
              "match_score": null,
              "text": "작업자는 분진 방지용 마스크를 사용할 것."
