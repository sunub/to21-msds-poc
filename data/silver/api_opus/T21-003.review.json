  },
  {
    "bundle": "b4",
    "msds_index": 0,
    "field": "intl_class[0]",
    "page": 7,
    "source_text": "○ EU 분류 정보 * 확정분류 결과 - [육플루오린화 황] : 해당없음",
    "rules": [
