    ],
    "note": "경로가 없어 endpoint null"
  },
  {
    "bundle": "b3",
    "msds_index": 0,
    "field": "ecotox[0]",
    "page": 9,
    "source_text": "수생생물에 대한 독성 평가: 자료없음.",
