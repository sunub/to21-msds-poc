    "source_text": "나. 환경을 보호하기 위해 필요한 조치사항 - 제품이 토양이나 수원에 흘러 들어가지 않도록 할 것",
    "rules": [
      "R14"
    ],
    "note": null
  },
  {
    "bundle": "b5",
    "msds_index": 0,
    "field": "narratives[S6_CLEANUP]",
