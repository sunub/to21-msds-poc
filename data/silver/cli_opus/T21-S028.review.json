    "rules": [
      "R14"
    ],
    "note": null
  },
  {
    "bundle": "b5",
    "msds_index": 0,
    "field": "narratives[S5_MEDIA]",
    "page": 3,
    "source_text": "- 입자상 분말 소화약제, 이산화탄소, 물분무, 일반적인 포말",
    "rules": [
      "R14"
    ],
    "note": null
