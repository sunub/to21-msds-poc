  {
    "bundle": "b5",
    "msds_index": 0,
    "field": "narratives[15]",
    "page": 5,
    "source_text": "○ 피부 보호: 내화학성 보호장갑을 착용하시오.",
    "rules": [
      "R14",
      "R25"
