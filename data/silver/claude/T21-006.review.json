  {
    "bundle": "b5",
    "msds_index": 0,
    "field": "narratives[14]",
    "page": 5,
    "source_text": "○ 눈/얼굴 보호: 고글형 보안경을 착용하시오.",
    "rules": [
      "R14",
      "R25"
