  {
    "bundle": "b5",
    "msds_index": 0,
    "field": "narratives[16]",
    "page": 5,
    "source_text": "○ 신체 보호: 내화학성 보호복을 착용하시오.",
    "rules": [
      "R14"
    ],
    "note": null
