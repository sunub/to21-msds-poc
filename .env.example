# 복사해서 .env 로 쓴다. 실제 .env 는 올리지 않는다.
# 역할 C, D, E 는 키가 필요 없다. 비워 두어도 된다.

# 교육원 키 (실버 추출, 키 점검). 키를 가진 사람에게 직접 받는다.
LLM_API_KEY=
LLM_BASE_URL=https://monogpt.kr/api/monorouter/v1

# 오픈소스 모델 서버 (역할 B 가 RunPod 에서 vLLM 을 띄운 뒤 채운다)
VLLM_BASE_URL=
VLLM_API_KEY=

# 예비: 팀원 Claude 키 (교육원 키를 못 쓸 때만, D-42)
ANTHROPIC_API_KEY=
