# 복사해서 .env 로 쓴다. 실제 .env 는 올리지 않는다.
# 역할 C, D, E 는 키가 필요 없다. 비워 두어도 된다.

# 교육원 키 (실버 추출, 키 점검). 키를 가진 사람에게 직접 받는다.
LLM_API_KEY=
LLM_BASE_URL=https://monogpt.kr/api/monorouter/v1

# 오픈소스 모델 서버 (역할 B 가 RunPod 에서 vLLM 을 띄운 뒤 채운다)
VLLM_BASE_URL=
VLLM_API_KEY=

# 항목별 추출 모델 서버
# RNGD furiosa-llm 서버
# RNGD_BASE_URL: 내 컴퓨터 쪽 터널 주소(예: http://127.0.0.1:18000/v1). 작업 화면의 터널 열기가 이 포트를 RNGD 8000번에 잇는다.
RNGD_BASE_URL=
RNGD_API_KEY=
# RunPod vLLM 서버 (qwen36_35b_runpod, qwen36_35b_runpod_48g, qwen36_35b_runpod_48g_det, nuextract2_8b_runpod)
# RUNPOD_VLLM_BASE_URL: RunPod 프록시 주소(https://<Pod 번호>-8000.proxy.runpod.net/v1). 작업 화면이 만든·이어 쓰는 Pod는 앱이 작업에 넣어 주므로 비워 둬도 된다.
#   팀 공유 Pod: 관리자는 터널(http://127.0.0.1:18000/v1), 팀원은 관리자가 알려 준 프록시 주소. Pod를 바꾸면 이 줄만 바꾼다 (deploy/runpod/README.md)
#   확인: cd backend && uv run python scripts/model_check.py --tag qwen36_35b_runpod_48g
RUNPOD_VLLM_BASE_URL=
# RUNPOD_VLLM_API_KEY: Pod vLLM 키. 작업 화면이 Pod를 만들 때 이 값을 Pod에 넣고, 앱을 다시 켜도 같은 키로 이어 쓴다. 비우면 Pod를 만들 수 없다.
# 만들기 예: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'. 바꾸면 떠 있는 Pod는 다시 만들어야 한다.
RUNPOD_VLLM_API_KEY=

# 예비: 팀원 Claude 키 (교육원 키를 못 쓸 때만, D-42)
ANTHROPIC_API_KEY=

# RunPod REST 키 (Pod 만들기·지우기. scripts/pod.py, 작업 화면 서버 탭)
RUNPOD_API_KEY=
# RNGD ssh 접속 인자 (예: -i ~/.ssh/<키 파일> -p <포트> <사용자>@<호스트>). 작업 화면 서버 탭이 쓴다
RNGD_SSH=

# 이 컴퓨터의 Ollama (local_qwen35_ollama)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=
