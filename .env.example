# 복사해서 .env 로 쓴다. 실제 .env 는 올리지 않는다.
# 역할 C, D, E 는 키가 필요 없다. 비워 두어도 된다.

# 교육원 키 (실버 추출, 키 점검). 키를 가진 사람에게 직접 받는다.
LLM_API_KEY=
LLM_BASE_URL=https://monogpt.kr/api/monorouter/v1

# 오픈소스 모델 서버 (역할 B 가 RunPod 에서 vLLM 을 띄운 뒤 채운다)
VLLM_BASE_URL=
VLLM_API_KEY=

# 항목별 추출 모델 서버. 주소는 SSH 터널 주소 (예: http://127.0.0.1:18000/v1)
# RNGD furiosa-llm 서버
RNGD_BASE_URL=
RNGD_API_KEY=
# RunPod vLLM 서버 (qwen36_35b_runpod, nuextract2_8b_runpod)
RUNPOD_VLLM_BASE_URL=
RUNPOD_VLLM_API_KEY=

# 예비: 팀원 Claude 키 (교육원 키를 못 쓸 때만, D-42)
ANTHROPIC_API_KEY=

# RunPod REST 키 (Pod 만들기·지우기. scripts/pod.py, 작업 화면 서버 탭)
RUNPOD_API_KEY=
# RNGD ssh 접속 인자 (예: -i ~/.ssh/<키 파일> -p <포트> <사용자>@<호스트>). 작업 화면 서버 탭이 쓴다
RNGD_SSH=
